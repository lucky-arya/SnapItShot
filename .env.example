# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/snapitshot

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary Media Storage (Optional for initial development, fallback mock data used when absent)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Nodemailer / Resend / SendGrid)
EMAIL_SERVICE=smtp
EMAIL_FROM=Abhishek Arya <contact@snapitshot.com>
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_password
